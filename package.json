{
  "name": "skillcab",
  "version": "0.3.0",
  "description": "A local console for discovering, installing and managing global and project Agent Skills",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byteee-com/skillcab.git"
  },
  "bin": {
    "skillcab": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "tsup && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests scripts *.json *.ts *.md docs",
    "format:check": "prettier --check src tests scripts *.json *.ts *.md docs",
    "start": "node dist/cli.js",
    "dev": "pnpm build && node dist/cli.js ui",
    "prepack": "pnpm build",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "commander": "14.0.1",
    "fastify": "5.6.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "0.468.0",
    "prettier": "3.6.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "@playwright/test": "1.56.1"
  }
}
